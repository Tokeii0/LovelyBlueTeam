# Copy to .env; never commit the resulting file.
PANEL_URL=https://panel.example.com:18479
PANEL_API_KEY=
PANEL_API_PREFIX=/api/v2
PORT=8787
REQUEST_TIMEOUT=12
AGENT_BIND=127.0.0.1
AGENT_PORT=8788
AGENT_PUBLIC_URL=https://logs.example.com
BLACKLIST_API_KEY=
# Local classification runs without sending content to a model.
AI_ENABLED=true
AI_ANALYSIS_MODE=local
AUTO_BLOCK=false
LOCAL_RULE_AGENT_IDS=
AI_CONFIDENCE=0.95
AI_BATCH_SIZE=500
AI_CONCURRENCY=4
AI_INTERVAL=2
IP_ALLOWLIST=
AI_ALLOW_PRIVATE_IPS=false
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_MODEL=
# This rule is disabled in a fresh database. Only use a dedicated decoy site.
SITE_RULE_DOMAIN=honeypot.example.com
AF_ENABLED=false
AF_URL=
AF_USERNAME=
AF_PASSWORD=
AF_NAMESPACE=public
AF_VERIFY_TLS=true
AF_INTERVAL=300
AF_REMOVE=false
AF_INCLUDE_PRIVATE=false
NAPCAT_ENABLED=false
NAPCAT_URL=http://127.0.0.1:3000
NAPCAT_TOKEN=
