# Inspect the original, non-normalized URI path. Put before existing rules.
# Block dot segments even when a valid-looking session parameter is present.
RewriteCond %{REQUEST_URI} .*(?:/|%(?:25)*2f)(?:\.|%(?:25)*2e){1,2}(?:;|/|%(?:25)*2f|$).* [NC]
RewriteRule ^.*$ - [F,L]

# Allow only literal ;jsessionid=<value>, ending at a slash or end of path.
# Keep encoded semicolons and all other semicolon parameters blocked.
RewriteCond %{REQUEST_URI} .*(?:%(?:25)*3b|;(?!jsessionid=[A-Za-z0-9._-]+(?:/|$))).* [NC]
RewriteRule ^.*$ - [F,L]
