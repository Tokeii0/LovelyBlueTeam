# Install in http{} after supplying the certificate files and trusted sources.
# Proxies only the authenticated collector, never the local administration UI.
server {
    listen 443 ssl;
    server_name logs.example.com;
    ssl_certificate /etc/nginx/tls/logs.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/logs.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    access_log logs/agent-access.log bt_access;
    # Replace this documentation address with authorized collector networks.
    allow 192.0.2.0/24;
    deny all;
    location /v1/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
