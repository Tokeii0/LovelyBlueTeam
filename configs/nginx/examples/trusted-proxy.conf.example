# Only when this Nginx is behind a known proxy and ngx_http_realip_module exists.
# Replace the example network with the exact source range of that trusted hop.
set_real_ip_from 192.0.2.0/24;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
# Do not trust 0.0.0.0/0 or an arbitrary request-provided address.
